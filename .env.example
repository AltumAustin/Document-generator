# Database (use a cloud PostgreSQL for Vercel, e.g. Vercel Postgres, Neon, Supabase)
DATABASE_URL=postgresql://docgen:docgen_password@localhost:5432/docgen
# DIRECT_URL is required by Prisma schema - for local dev, same as DATABASE_URL
# For Vercel Postgres with connection pooling, use the non-pooled (direct) connection string
DIRECT_URL=postgresql://docgen:docgen_password@localhost:5432/docgen

NEXTAUTH_SECRET=your-secret-change-in-production
# NEXTAUTH_URL is auto-detected on Vercel; set only for local dev or custom domains
NEXTAUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=docgen
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=http://localhost:9000

SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@yourdomain.com

WEBHOOK_SIGNING_SECRET=whsec_your_secret_here
